# Ignore object files
*.o

# Ignore executable files
*.exe
*.out
*.app

# Ignore other binaries (note: gitignore has no inline comments; keep them on their own lines)
*.dll
*.so
*.dylib
*.a
*.class

# Ignore build directories
/build/
/bin/
/obj/

# Ignore generated files
*.gch
*.pyc

# LaTeX generated files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.idx
*.ilg
*.ind
*.nav
*.snm
*.vrb

# LaTeX temp directories
.fuse_hidden*

# LaTeX editor files
*.backup
*.swp
*.swo
*~

# PDF output (keep source, ignore compiled PDFs for now)
*.pdf

# Core dumps
core
